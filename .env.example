# Server
NODE_ENV=development
PORT=5000
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
CORS_EXTRA_ORIGINS=
TRUST_PROXY=0

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/supply-medicals
# Use true with a replica set. Standalone local MongoDB is allowed only with
# ALLOW_TRANSACTIONS=false and the documented compensation strategy.
ALLOW_TRANSACTIONS=true
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Auth
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_NAME=sm_refresh_token
COOKIE_SAME_SITE=lax
BCRYPT_ROUNDS=12

# Uploads: local or s3
FILE_STORAGE_CONFIG=local
LOCAL_STORAGE_PATH=./storage/uploads
MAX_FILE_SIZE_MB=10
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional business AI. Leave blank to show configuration state; never use fake AI.
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_MS=45000
AI_REQUIREMENT_MIN_CONFIDENCE=0.75

# Optional email delivery
EMAIL_CONFIG=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Supply Medicals <no-reply@example.com>

# Rate limits/logging
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=40
LOG_LEVEL=info

# Development seed credentials are generated per run unless explicitly set here.
# Never place real staff/customer credentials in a committed env file.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_SALESMAN_EMAIL=
SEED_SALESMAN_PASSWORD=
SEED_CUSTOMER_EMAIL=
SEED_CUSTOMER_PASSWORD=
SEED_SECONDARY_CUSTOMER_EMAIL=
SEED_SECONDARY_CUSTOMER_PASSWORD=
SEED_PENDING_CUSTOMER_EMAIL=
SEED_PENDING_CUSTOMER_PASSWORD=

# Live smoke-test credentials. Development only.
SMOKE_BASE_URL=http://localhost:5000/api
SMOKE_ADMIN_EMAIL=
SMOKE_ADMIN_PASSWORD=
SMOKE_SALESMAN_EMAIL=
SMOKE_SALESMAN_PASSWORD=
SMOKE_CUSTOMER_EMAIL=
SMOKE_CUSTOMER_PASSWORD=
SMOKE_ALLOW_MUTATION=false

# Frontend (put in frontend/.env.local)
SITE_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
