# ---------------------------------------------------------------------------
# Supply Medicals backend environment.
# Mirrors the values documented in the repository root .env.example.
# Copy to `.env` and replace every placeholder. Never commit `.env`.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=5000
SERVER_URL=http://localhost:5000
# Comma separated exact CORS allowlist (frontend origins).
CLIENT_URL=http://localhost:5173
# Comma separated extra allowed origins (optional).
CORS_EXTRA_ORIGINS=
# Number of reverse proxies in front of the app (0 = none). Needed for rate limiting / secure cookies.
TRUST_PROXY=0

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/supply-medicals
# Set to false only for a single-node development server that cannot run transactions.
# The backend then uses the documented conditional-update + compensation saga.
ALLOW_TRANSACTIONS=true
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Supabase — PostgreSQL + Auth (phase 1 of the migration; see docs/SUPABASE_MIGRATION.md)
# Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: only for a project still signing access tokens with the legacy HS256 secret.
SUPABASE_JWT_SECRET=
# Project Settings -> Database: pooled / transaction mode (port 6543)
DATABASE_URL=
# Project Settings -> Database: direct connection (port 5432), migrations only
DIRECT_URL=

# Authentication - generate independent random values of at least 32 characters
# (for example: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_NAME=sm_refresh_token
COOKIE_SAME_SITE=lax
BCRYPT_ROUNDS=12

# Uploads: local or s3
FILE_STORAGE_CONFIG=local
LOCAL_STORAGE_PATH=./storage/uploads
MAX_FILE_SIZE_MB=10
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Optional business AI. Leave blank to show configuration state; never use fake AI.
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_MS=45000
AI_REQUIREMENT_MIN_CONFIDENCE=0.75

# Optional email delivery.
#   console  - never leaves the process; the message body is written to the log
#   smtp     - real delivery, requires SMTP_HOST / SMTP_USER / SMTP_PASS
#   disabled - no email at all; the API still works, only notifications are lost
# There is no fake mail integration: nothing is "sent" unless a transport is
# configured. `POST /api/public/contact` never sends email in any mode.
EMAIL_CONFIG=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Supply Medicals <no-reply@example.com>

# Rate limiting and logging
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=40
# The public `POST /api/public/contact` form additionally has a fixed, IP-scoped
# limiter (10 submissions per hour). Set TRUST_PROXY correctly behind a load
# balancer or every visitor will share the proxy's address.
LOG_LEVEL=info

# Development seed (optional explicit override; otherwise generated per run)
SEED_ADMIN_EMAIL=admin@demo.supplymedicals.test
SEED_ADMIN_PASSWORD=
SEED_SALESMAN_EMAIL=salesman@demo.supplymedicals.test
SEED_SALESMAN_PASSWORD=
SEED_CUSTOMER_EMAIL=owner@demo.supplymedicals.test
SEED_CUSTOMER_PASSWORD=
SEED_SECONDARY_CUSTOMER_EMAIL=citycare@demo.supplymedicals.test
SEED_SECONDARY_CUSTOMER_PASSWORD=
SEED_PENDING_CUSTOMER_EMAIL=pending@demo.supplymedicals.test
SEED_PENDING_CUSTOMER_PASSWORD=
