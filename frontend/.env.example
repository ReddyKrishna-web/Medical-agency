# Base URL for the API, including /api
VITE_API_URL=http://localhost:5000/api

# Optional Socket.IO origin. Leave blank when sockets are not configured.
VITE_SOCKET_URL=http://localhost:5000

# Public website origin used to generate robots.txt and an absolute sitemap.
# Required when NODE_ENV=production during a production build.
SITE_URL=http://localhost:5173

# Used in metadata and an optional visible email fallback. Leave blank when
# the public agency endpoint supplies the real address. No secrets belong here.
VITE_APP_NAME=Supply Medicals
VITE_CONTACT_EMAIL=
